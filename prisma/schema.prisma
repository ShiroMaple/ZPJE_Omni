generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// 门节点应用注册模型
model App {
  id          String   @id @default(cuid())
  key         String   @unique // 唯一样本标识，如 "CarbonPlatform"
  name        String   // 显示名称，如 "能碳管理平台"
  description String?  @db.Text // 简介/描述
  url         String   // 访问入口 URL
  icon        String?  // 图标名称 (如 Lucide 图标名 "Zap", "Activity")
  color       String?  // 主题色名称 (如 "emerald", "blue", "amber", "purple", "cyan", "slate")
  
  // 状态与排序控制
  isMaintenance Boolean @default(false) // 是否开启维护模式
  sortOrder     Int     @default(0)     // 显示排序权值
  
  // 实时健康探活缓存
  healthStatus  String  @default("HEALTHY") // HEALTHY, UNHEALTHY, UNKNOWN
  lastCheckedAt DateTime?

  // 所属部门标签外键
  mainDeptId    String?
  mainDept      Department? @relation(fields: [mainDeptId], references: [id], onDelete: SetNull)

  visibleToAll  Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  favorites   UserFavorite[]
  accessLogs  AccessLog[]
  rolePermissions AppRolePermission[]
  deptPermissions AppDepartmentPermission[]
  widgets        Widget[]

  @@map("apps")
}

// 组织架构：单位模型
model Unit {
  id          String       @id
  name        String
  code        String?
  enabled     Boolean      @default(true)
  
  // 关联关系
  departments Department[]
  members     Member[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("units")
}

// 组织架构：部门模型
model Department {
  id           String   @id
  name         String
  code         String?
  enabled      Boolean  @default(true)
  
  // 关联关系
  orgAccountId String
  unit         Unit     @relation(fields: [orgAccountId], references: [id], onDelete: Cascade)
  parentId     String?  // 父级部门ID

  members      Member[]
  apps         App[]
  appPermissions AppDepartmentPermission[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt


  @@map("departments")
}

// 组织架构：人员模型
model Member {
  id              String      @id
  name            String
  loginName       String      @unique // 登录账号，单点登录校验的关键映射
  code            String?     // 人员工号
  telNumber       String?     // 手机号码
  emailAddress    String?     // 电子邮件
  enabled         Boolean     @default(true)
  isDeleted       Boolean     @default(false)
  adminType       AdminType   @default(NONE) // 管理员权限分级：NONE, SYS_ADMIN, OPS_ADMIN, DEPT_ADMIN

  // 关联关系
  orgAccountId    String
  unit            Unit        @relation(fields: [orgAccountId], references: [id], onDelete: Cascade)
  
  orgDepartmentId String?
  department      Department? @relation(fields: [orgDepartmentId], references: [id], onDelete: SetNull)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  roles           MemberRole[]

  @@map("members")
}

// 常用应用收藏模型
model UserFavorite {
  id        String   @id @default(cuid())
  loginName String   // 用户登录账号
  appId     String   // 收藏的应用ID
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([loginName, appId]) // 联合唯一约束
  @@map("user_favorites")
}

// 访问审计与行为日志模型
model AccessLog {
  id        String   @id @default(cuid())
  loginName String   // 用户登录账号
  appId     String   // 访问的应用ID
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  ip        String?  // 访问 IP 地址
  userAgent String?  @db.Text // 浏览器 User Agent
  timestamp DateTime @default(now())

  @@map("access_logs")
}

// 角色模型
model Role {
  id          String   @id @default(cuid())
  key         String   @unique // 例如 "admin", "operator", "user"
  name        String   // 例如 "系统管理员", "操作员", "普通员工"
  members     MemberRole[]
  permissions AppRolePermission[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

// 人员所属角色关联模型
model MemberRole {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([memberId, roleId])
  @@map("member_roles")
}

// 应用角色权限关联模型
model AppRolePermission {
  id        String   @id @default(cuid())
  appId     String
  app       App      @relation(fields: [appId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([appId, roleId])
  @@map("app_role_permissions")
}

// 应用部门可见性关联模型
model AppDepartmentPermission {
  id           String     @id @default(cuid())
  appId        String
  app          App        @relation(fields: [appId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([appId, departmentId])
  @@map("app_department_permissions")
}

// 首页 Widget 看板数据模型
model Widget {
  id          String   @id @default(cuid())
  title       String   // 看板标题
  appId       String?  // 关联的子系统ID
  app         App?     @relation(fields: [appId], references: [id], onDelete: SetNull)
  type        String   // "iframe" 或者是 "api"
  url         String   // 数据获取端点或网页地址 (支持大文本) @db.Text
  widthClass  String   @default("col-span-1") // 网格占比: col-span-1, col-span-2, col-span-3
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("widgets")
}

// 管理员级别枚举
enum AdminType {
  NONE
  SYS_ADMIN
  OPS_ADMIN
  DEPT_ADMIN
}

// 统一系统操作与审计日志模型
model SystemLog {
  id         String   @id @default(cuid())
  loginName  String   // 操作用户登录名
  userName   String?  // 操作用户姓名
  actionType String   // "SSO_LOGIN" | "LOGOUT" | "APP_ACCESS" | "APP_MANAGE" | "WIDGET_MANAGE" | "ADMIN_MANAGE"
  detail     String   @db.Text // 日志描述
  ip         String?  // 访问 IP 地址
  userAgent  String?  @db.Text // 浏览器终端 UA
  timestamp  DateTime @default(now())

  @@map("system_logs")
}